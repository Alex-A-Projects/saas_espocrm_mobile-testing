{
  "name": "saas_espocrm_mobile-testing",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:mobile",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:mobile": "npm run test:ios && npm run test:android",
    "test:ios:auth": "wdio run ./wdio.ios.conf.ts --spec tests/auth.spec.ts",
    "test:android:dashboard": "wdio run ./wdio.android.conf.ts --spec tests/dashboard.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "EspoCRM mobile E2E tests with WebdriverIO, Appium, TypeScript, Safari and Chrome",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "appium-xcuitest-driver": "^9.10.5",
    "dotenv": "^18.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  }
}
